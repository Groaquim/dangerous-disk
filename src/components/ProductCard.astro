---
interface Props {
  id: string;
  name: string;
  price: number;
  category: string;
  image: string;
}

const { id, name, price, category, image } = Astro.props;
---

<article class="product-card">
  <a href={`/articles/${id}`} class="image-wrapper">
    <img src={image} alt={name} loading="lazy" />
  </a>
  <div class="product-info">
    <span class="category">{category}</span>
    <h3 class="title">
      <a href={`/articles/${id}`}>{name}</a>
    </h3>
    <p class="price">{price.toFixed(2)} €</p>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #eee;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 20px rgba(0, 0, 0, 0.06);
  }

  .image-wrapper {
    aspect-ratio: 4/5;
    width: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-card:hover .image-wrapper img {
    transform: scale(1.04);
  }

  .product-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .category {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #888;
    font-weight: 600;
  }

  .title {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .title a {
    text-decoration: none;
    color: #111;
  }

  .price {
    font-size: 1rem;
    font-weight: 700;
    color: #111;
    margin-top: 0.2rem;
  }
</style>